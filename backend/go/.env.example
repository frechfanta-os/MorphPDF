# MorphPDF Backend Environment Configuration
MORPHPDF_ENV=development
MORPHPDF_HOST=0.0.0.0
MORPHPDF_PORT=8080

# AI Provider (OpenRouter) - Managed strictly by Go backend
# NEVER hardcode real API keys here.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Storage
STORAGE_PATH=/tmp/morphpdf_storage

# OCR Configuration (mlkit / paddleocr / tesseract)
OCR_ENGINE=mlkit

# Logging
LOG_LEVEL=info
